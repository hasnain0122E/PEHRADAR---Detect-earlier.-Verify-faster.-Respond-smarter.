# Copy to .env.local for local development.

# Public: inlined into the browser bundle at build time. Never put secrets in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only (M4): read by the operator proxy (src/app/api/operator) and added as the
# X-Operator-Key header on write calls. It never reaches the browser. Must equal the API's
# OPERATOR_API_KEY. Leave empty locally if the API has no key (dev allows writes without one).
OPERATOR_API_KEY=

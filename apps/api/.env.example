# Copy to .env for local overrides. Never commit .env. No secrets are needed yet.
# development | test | production (production disables /docs and requires https origins)
APP_ENV=development
# Comma-separated exact browser origins (scheme://host[:port]). '*' is always rejected.
# Unset -> local dev origins (localhost:3000) outside production; NO browser origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# M1c spike only: true runs the OpenCV/ONNX Runtime self-check at startup and logs versions.
CV_RUNTIME_CHECK=false
# M1d diagnostics: true mounts POST /api/v1/video/test (decode/sample benchmark, no detection).
VIDEO_TEST_ENABLED=false
# Video limits shared by /video/test and /detect/fire (M1d: GO WITH LIMITS).
MAX_UPLOAD_MB=20
VIDEO_MAX_SECONDS=60
VIDEO_SAMPLE_FPS=2
# Fire/smoke model (M2). Download with: uv run python -m app.detection.fetch_model
MODEL_PATH=models/fire_smoke_yolov8n_320.onnx
MODEL_SHA256=f2699b753e78be8d392bfa63e64bf102ea3ceb8b6086a59dfd8192b61a0c6fad
MODEL_THREADS=1
# Temporal confirmation: a class is confirmed when its score >= DETECT_CONF_THRESHOLD in at least
# DETECT_MIN_POSITIVE_FRAMES of any DETECT_WINDOW_FRAMES consecutive sampled frames.
DETECT_CONF_THRESHOLD=0.45
DETECT_MIN_POSITIVE_FRAMES=3
DETECT_WINDOW_FRAMES=5
# 0 disables the single-frame rule (one frame >= this value confirms on its own).
DETECT_SINGLE_FRAME_CONFIDENCE=0
# Evidence JPEGs (newest N kept). Unset dir -> <system temp>/pehradar-evidence.
EVIDENCE_MAX_FILES=20
# M3 persistence. Production REQUIRES a PostgreSQL URL (Neon), e.g.
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require   (never commit the real value)
# Unset outside production: local SQLite file ./pehradar-dev.db (git-ignored).
# DATABASE_URL=
# Shared demo key for state-changing calls (header X-Operator-Key). Production refuses those
# calls (503) until this is set. Generate a long random value; never commit it.
# OPERATOR_API_KEY=
# M5 demo scenario engine (seed/scenarios.json): runs licensed sample clips through the real
# detector on simulated demo-stream nodes. Unset: on outside production, OFF in production
# unless set to true. Never auto-confirms anything.
# SCENARIOS_ENABLED=true
# Optional: one trigger delay (seconds) for every scenario instead of the configured ones.
# SCENARIO_DELAY_OVERRIDE_S=
# Longest per-run delay an operator may request from Settings (seconds).
SCENARIO_MAX_DELAY_S=300
# M6B merge rule: a confirmed detection from the same camera and event type within this many
# minutes of an open incident's latest detection is added to that incident. 0 disables merging.
INCIDENT_MERGE_WINDOW_MIN=30
# M5 suggested response route: osrm (default; public OSRM demo server, light use only) or none.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_S=8

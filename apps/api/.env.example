# Copy to .env for local overrides. Never commit .env. No secrets are needed yet.
# development | test | production (production disables /docs and requires https origins)
APP_ENV=development
# Comma-separated exact browser origins (scheme://host[:port]). '*' is always rejected.
# Unset -> local dev origins (localhost:3000) outside production; NO browser origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
